# Copy to .env and adjust as needed. docker-compose.yml works fine with none of this set -
# these are the same defaults baked into application.properties, just overridable here
# without editing tracked files.

# Postgres
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay

# Links returned by the backend's GET / - adjust if you're exposing the dashboard/docs
# somewhere other than localhost. RELAY_DOCS_URL also becomes the docs site's own public
# URL at *build* time (canonical links, sitemap.xml, robots.txt, OG tags) - it's baked into
# the image, so changing it requires rebuilding the docs service, not just restarting it.
# The production instance builds with RELAY_DOCS_URL=https://relay.example.com.
RELAY_DOCS_URL=http://localhost:3001
RELAY_DASHBOARD_URL=http://localhost:3000

# Set to "seed" to populate the database with sample organizations/endpoints/topics/
# deliveries on startup. See /docs/installation for what it creates. Leave blank normally.
RELAY_BACKEND_PROFILE=

# Grafana admin login (username is always "admin"). Change this before exposing Grafana
# anywhere other than your own machine.
GRAFANA_ADMIN_PASSWORD=admin
